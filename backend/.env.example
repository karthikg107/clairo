APP_ENV=development
LOG_LEVEL=INFO
SENTRY_DSN=

# Local dev only — production uses AWS Secrets Manager (or SECRETS_BACKEND=env
# on a non-AWS host, e.g. Render — see app/core/secrets.py)
ANTHROPIC_API_KEY=REPLACE_ME
# Optional — set LLM_PROVIDER=openai to route analysis/classification through
# OpenAI instead of Claude (e.g. if you don't have an Anthropic key)
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
DATABASE_URL=postgresql+asyncpg://clairo:clairo_dev@localhost:5432/clairo_dev
REDIS_URL=redis://localhost:6379
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_STARTER_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_STARTER_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_PRO_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_TEAM_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_TEAM_ANNUAL=price_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
# Required to actually enforce auth locally — without it the JWT middleware
# is disabled (useful for quick local testing, wrong for anything real)
CLERK_ISSUER=
GOOGLE_CLOUD_PROJECT_ID=REPLACE_ME
GOOGLE_CLOUD_CREDENTIALS_JSON=REPLACE_ME
# Optional — set OCR_PROVIDER=gcv to use Google Cloud Vision instead of the
# default in-container Tesseract for image/photo OCR
OCR_PROVIDER=tesseract
